rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Un-blurred party originals: admin only (needed to re-edit blurring later).
    match /parties-private/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Finance: expense receipts and payroll time-card photos — signed-in only.
    match /receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /timecards/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
