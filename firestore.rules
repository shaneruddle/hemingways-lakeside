rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read: menu, events, specials, blog, pool
    match /menu_images/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /menu/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /specials/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blog/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sports/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pool_packages/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Enquiries & CRM — write-only for public, read for admin
    match /enquiries/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /crm_contacts/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
