rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read: menu, events, specials, blog, pool
    match /event_galleries/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /menu_images/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /menu/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /specials/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blog/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sports/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pool_packages/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /digital_menu_categories/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /digital_menu_items/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Enquiries & CRM — write-only for public, read for admin
    match /enquiries/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /crm_contacts/{doc} {
      allow read, write: if request.auth != null;
    }

    // Users — only auth'd users can read/write their own; admin reads all
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }

    // System logs — auth write, auth read
    match /system_logs/{doc} {
      allow read, write: if request.auth != null;
    }

    // Loyalty — auth only
    match /loyalty_customers/{doc} {
      allow read, write: if request.auth != null;
      match /transactions/{tx} {
        allow read, write: if request.auth != null;
      }
    }

    // Finance — auth only
    match /finance_expenses/{doc} {
      allow read, write: if request.auth != null;
    }
    match /finance_income/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
